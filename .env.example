# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password

# --- Auth ---
# At least 32 random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# true when served over HTTPS
JWT_COOKIE_SECURE=false

# --- URLs ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
BACKEND_PORT=8100
NEXT_PUBLIC_API_URL=http://localhost:8100/api

# --- Seed data (first start only) ---
SEED_ENABLED=true
ADMIN_EMAIL=admin@smartcart.local
ADMIN_PASSWORD=Admin@12345

# --- Payments (real money only - there is no simulator) ---
# Razorpay Dashboard -> Account & Settings -> API Keys -> Generate Key.
#   rzp_test_... = Test mode (use UPI success@razorpay / test cards, no real money)
#   rzp_live_... = Live mode (real payments; requires an activated account)
# Without these two values checkout returns HTTP 503 "Razorpay is not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> Add New Webhook
#   URL:    https://<your-public-api>/api/webhooks/razorpay   (locally: an ngrok / cloudflared tunnel to :8100)
#   Secret: any strong string - paste the same value here
#   Events: payment.authorized, payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=

# PhonePe PG Standard Checkout v2 (PhonePe Business dashboard → Developer settings).
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# SANDBOX or PRODUCTION
PHONEPE_ENV=SANDBOX
# Dashboard → Webhooks: URL https://<your-api>/api/webhooks/phonepe with a username/password;
# PhonePe sends Authorization: SHA256(username:password).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- Email notifications ---
# Sent on signup, payment received/failed, shipped, delivered and cancelled.
# Default (docker compose): delivered to Mailpit, view them at http://localhost:8025.
# Real inboxes via Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SMTP_AUTH=true,
#   MAIL_SMTP_STARTTLS=true, MAIL_USERNAME=<you@gmail.com>, MAIL_PASSWORD=<16-char App Password,
#   Google Account -> Security -> 2-Step Verification -> App passwords>, MAIL_FROM=<you@gmail.com>.
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@smartcart.local
MAIL_FROM_NAME=Smart Cart